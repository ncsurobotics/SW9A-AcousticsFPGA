# CompilerName=msvc170
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root\build\win64
matlabdir = C:\Program Files\MATLAB\R2025b
startdir = C:\Users\Aweso\Verilog\Aquapack\bartlett\sim\bartlett_datapath\codegen\hilbert_fir_filter_1027\cosim

# Toolchain information
cc = cl
cxx = cl
linker = link
linkerxx = link

cflags =  /c /Zc:__cplusplus /Zp8 /GR /W3 /EHs /nologo /MD /D_CRT_SECURE_NO_DEPRECATE /D_SCL_SECURE_NO_DEPRECATE /D_SECURE_SCL=0   /DMATLAB_MEX_FILE  /DMATLAB_MEX_FILE /O2 /Oy- /DNDEBUG /fp:strict /utf-8 /I "$root" /I "$startdir" /I "$root\interface" /I "$matlabdir\extern\include" /I "." -DMODEL=hilbert_fir_filter_1027_cosim_mex  

cxxflags =  /c /Zc:__cplusplus /Zp8 /GR /W3 /EHs /nologo /MD /D_CRT_SECURE_NO_DEPRECATE /D_SCL_SECURE_NO_DEPRECATE /D_SECURE_SCL=0   /DMATLAB_MEX_FILE  /DMATLAB_MEX_FILE /O2 /Oy- /DNDEBUG /fp:strict /utf-8 /I "$root" /I "$startdir" /I "$root\interface" /I "$matlabdir\extern\include" /I "." -DMODEL=hilbert_fir_filter_1027_cosim_mex  

ldflags =  /nologo    /DLL /LIBPATH:"$matlabdir\extern\lib\win64\microsoft" libmx.lib libmex.lib libmat.lib kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib  /out:"hilbert_fir_filter_1027_cosim_mex.mexw64" libemlrt.lib libcovrt.lib libut.lib libmwmathutil.lib  /export:mexFunction /export:mexfilerequiredapiversion /export:emlrtMexFcnProperties /export:hilbert_fir_filter_1027_cosim /export:hilbert_fir_filter_1027_cosim_initialize /export:hilbert_fir_filter_1027_cosim_terminate /export:hilbert_fir_filter_1027_cosim_atexit /export:emlrt_marshallOut /export:b_emlrt_marshallOut

ldxxflags =  /nologo    /DLL /LIBPATH:"$matlabdir\extern\lib\win64\microsoft" libmx.lib libmex.lib libmat.lib kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib libMatlabDataArray.lib libMatlabEngine.lib  /out:"hilbert_fir_filter_1027_cosim_mex.mexw64" libemlrt.lib libcovrt.lib libut.lib libmwmathutil.lib  /export:mexFunction /export:mexfilerequiredapiversion /export:emlrtMexFcnProperties /export:hilbert_fir_filter_1027_cosim /export:hilbert_fir_filter_1027_cosim_initialize /export:hilbert_fir_filter_1027_cosim_terminate /export:hilbert_fir_filter_1027_cosim_atexit /export:emlrt_marshallOut /export:b_emlrt_marshallOut

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in /Fo$out

rule cxx
    command = $cxx $cxxflags $in /Fo$out

rule link
    command = $linker @$out.rsp $linkobjs $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir\hilbert_fir_filter_1027_cosim_data.obj : cc $root\hilbert_fir_filter_1027_cosim_data.c
build $builddir\rt_nonfinite.obj : cc $root\rt_nonfinite.c
build $builddir\hilbert_fir_filter_1027_cosim_initialize.obj : cc $root\hilbert_fir_filter_1027_cosim_initialize.c
build $builddir\hilbert_fir_filter_1027_cosim_terminate.obj : cc $root\hilbert_fir_filter_1027_cosim_terminate.c
build $builddir\hilbert_fir_filter_1027_cosim.obj : cc $root\hilbert_fir_filter_1027_cosim.c
build $builddir\SystemCore.obj : cc $root\SystemCore.c
build $builddir\AbstractFilterBank.obj : cc $root\AbstractFilterBank.c
build $builddir\hilbert_fir_filter_1027.obj : cc $root\hilbert_fir_filter_1027.c
build $builddir\_coder_hilbert_fir_filter_1027_cosim_api.obj : cc $root\interface\_coder_hilbert_fir_filter_1027_cosim_api.c
build $builddir\_coder_hilbert_fir_filter_1027_cosim_mex.obj : cc $root\interface\_coder_hilbert_fir_filter_1027_cosim_mex.c
build $builddir\hilbert_fir_filter_1027_cosim_mexutil.obj : cc $root\hilbert_fir_filter_1027_cosim_mexutil.c
build $builddir\_coder_hilbert_fir_filter_1027_cosim_info.obj : cc $root\interface\_coder_hilbert_fir_filter_1027_cosim_info.c
build $builddir\c_mexapi_version.obj : cc $matlabdir\extern\version\c_mexapi_version.c

# Link
build $root\hilbert_fir_filter_1027_cosim_mex.mexw64 : link $builddir\hilbert_fir_filter_1027_cosim_data.obj $builddir\rt_nonfinite.obj $builddir\hilbert_fir_filter_1027_cosim_initialize.obj $builddir\hilbert_fir_filter_1027_cosim_terminate.obj $builddir\hilbert_fir_filter_1027_cosim.obj $builddir\SystemCore.obj $builddir\AbstractFilterBank.obj $builddir\hilbert_fir_filter_1027.obj $builddir\_coder_hilbert_fir_filter_1027_cosim_api.obj $builddir\_coder_hilbert_fir_filter_1027_cosim_mex.obj $builddir\hilbert_fir_filter_1027_cosim_mexutil.obj $builddir\_coder_hilbert_fir_filter_1027_cosim_info.obj $builddir\c_mexapi_version.obj 
